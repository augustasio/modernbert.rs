{
  "label": "10 threads: rung 0 ruler against rung1",
  "ruler": {
    "name": "rung0",
    "command": [
      "python/.venv/bin/python",
      "python/worker.py",
      "--rung",
      "0"
    ]
  },
  "variant": {
    "name": "rung1",
    "command": [
      "python/.venv/bin/python",
      "python/worker.py",
      "--rung",
      "1"
    ]
  },
  "threads": 10,
  "cycles": 30,
  "examples_per_slice": 64,
  "warmup_examples": 3,
  "seed": 10000,
  "weights": "weights/ModernBERT-Large-Instruct",
  "prompt_ids": "data/agnews_test_prompt_ids.tsv",
  "reference_logits": "results/rung0_logits.npy",
  "thermal_helper": "target/tools/thermal_state",
  "powermetrics": [
    "sudo",
    "-n",
    "/usr/bin/powermetrics"
  ]
}
