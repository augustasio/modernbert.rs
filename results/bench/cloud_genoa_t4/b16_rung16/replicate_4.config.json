{
  "label": "cloud, 4 threads, batches of 16: rung 0 ruler against rung16 (replicate 4)",
  "ruler": {
    "name": "rung0",
    "command": [
      "python/.venv/bin/python",
      "python/worker.py",
      "--rung",
      "0"
    ]
  },
  "variant": {
    "name": "rung16",
    "command": [
      "target/bench/rung16/release/worker"
    ]
  },
  "threads": 4,
  "cycles": 30,
  "examples_per_slice": 16,
  "warmup_examples": 16,
  "seed": 4004,
  "weights": "weights/ModernBERT-Large-Instruct",
  "prompt_ids": "data/agnews_test_prompt_ids.tsv",
  "reference_logits": "results/rung0_logits.npy",
  "thermal_helper": "target/tools/thermal_state",
  "powermetrics": null,
  "batch_size": 16
}